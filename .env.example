DATABASE_URL="file:./dev.db"

# Email of the account the seed script always upserts as an admin. No
# password needed - everyone signs in with Microsoft; this just grants that
# email admin access on (or before) its first sign-in.
ADMIN_EMAIL="catherine.muthoni@medtroniclabs.org"

# Random string used to sign/namespace session data. Any long random value works.
SESSION_SECRET="replace-with-a-long-random-string"

# Used to build absolute links (e.g. the Microsoft sign-in redirect URI).
# Defaults to the request origin if unset - set explicitly in production
# behind a proxy/CDN.
APP_URL="http://localhost:3000"

# Microsoft (Entra ID) app registration - see README "Microsoft sign-in
# setup" for how to create one. AZURE_AD_TENANT_ID defaults to "common"
# (any Microsoft account, work/school or personal); set it to your tenant
# ID to restrict sign-in to one organization instead.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"
